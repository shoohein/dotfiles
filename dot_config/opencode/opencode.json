{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "lsp": true,
  "instructions": [
    "https://raw.githubusercontent.com/shoohein/opencode-config/refs/heads/main/instructions/critical-thinking.md",
    "https://raw.githubusercontent.com/shoohein/opencode-config/refs/heads/new-main/instructions/documentation-policy.md",
    "https://raw.githubusercontent.com/shoohein/opencode-config/refs/heads/new-main/instructions/session-status.md"
  ],
  "commands": {
    "ok": {
      "description": "\u5b9f\u884c\u3092\u8a31\u53ef\u3059\u308b",
      "template": "\u304a\u9858\u3044\u3057\u307e\u3059\u3002",
      "agent": "build"
    },
    "write": {
      "description": "\u30c9\u30ad\u30e5\u30e1\u30f3\u30c8\u3092\u4f5c\u6210\u3059\u308b",
      "template": "\u30c9\u30ad\u30e5\u30e1\u30f3\u30c8\u306e\u4f5c\u6210\u3092\u304a\u9858\u3044\u3057\u307e\u3059\u3002",
      "agent": "writer"
    },
    "commit": {
      "description": "\u5909\u66f4\u3092\u30b3\u30df\u30c3\u30c8\u3059\u308b",
      "template": "\u5909\u66f4\u3092\u30b3\u30df\u30c3\u30c8\u3057\u3066\u304f\u3060\u3055\u3044\u3002",
      "agent": "build"
    }
  },
  "agents": {
    "plan": {
      "temperature": 0.2
    },
    "build": {
      "temperature": 0.0
    },
    "explore": {
      "temperature": 0.3
    },
    "general": {},
    "writer": {
      "hidden": true
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "/home/agent/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    }
  ]
}
