#!/usr/bin/env bash

set -euo pipefail

source "${HOME}/.local/lib/devcontainer/common.sh"

devcontainer_require_commands
workspace="$(devcontainer_workspace_root)"
workdir="$(devcontainer_workdir "$workspace")"

devcontainer_up "$workspace"

exec devcontainer_exec "$workspace" sh -c '
  cd "$1"

  if [ -n "${SHELL:-}" ] && [ -x "$SHELL" ]; then
    exec "$SHELL" -i
  elif [ -x /bin/bash ]; then
    exec /bin/bash -i
  else
    exec /bin/sh -i
  fi
' sh "$workdir"
